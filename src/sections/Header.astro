---
import { getCollection } from "astro:content";
import Pill from "../components/Pill.astro";
import { byFileOrder } from "../content/listOrder";
import { getLabels, getSite } from "../content/requiredEntries";

const site = await getSite();
const labels = await getLabels();
const navSections = (await getCollection("sections"))
  .map((entry) => entry.data)
  .filter((section) => section.nav)
  .sort(byFileOrder);
---

<header>
  <a class="logo" href="#top">
    {site.name}
    <span class="logo-dot" aria-hidden="true">
      .
    </span>
  </a>
  <nav aria-label={labels.mainNav}>
    {navSections.map((section) =>
      section.navPill ? (
        <span class="nav-pill">
          <Pill href={`#${section.id}`}>{section.nav}</Pill>
        </span>
      ) : (
        <a class="nav-link" href={`#${section.id}`}>
          {section.nav}
        </a>
      ),
    )}
  </nav>
</header>

<style>
  header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3) var(--space-6);
  }

  .logo {
    color: inherit;
    font-weight: var(--weight-medium);
    text-decoration: none;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1);
    color: var(--color-muted);
  }

  .nav-link {
    padding: var(--space-2-5);
    color: inherit;
    text-decoration: none;
  }

  .logo:hover,
  .logo-dot,
  .nav-link:hover {
    color: var(--color-accent);
  }

  /* The Pill inherits its text colour, so the Header sets it here. */
  .nav-pill {
    margin-left: var(--space-2);
    color: var(--color-fg);
  }
</style>
