---
import { getCollection } from "astro:content";
import List from "../components/List.astro";
import Row from "../components/Row.astro";
import Section from "../components/Section.astro";
import { formatPeriod } from "../content/formatPeriod";
import { byNewest } from "../content/listOrder";
import { getLabels, getSection } from "../content/requiredEntries";
import type { CommunityItem } from "../content/types";

const section = await getSection("community");
const labels = await getLabels();
const items: CommunityItem[] = (await getCollection("community"))
  .map((entry) => entry.data)
  .sort(byNewest);
---

<Section
  id={section.id}
  title={section.title}
  description={section.description}
>
  <List>
    {items.map((item) => (
      <Row
        title={item.org}
        href={item.href}
        role={item.role}
        meta={formatPeriod(item, labels.now)}
        description={item.description}
      />
    ))}
  </List>
</Section>
