---
import { getCollection } from "astro:content";
import List from "../components/List.astro";
import Row from "../components/Row.astro";
import Section from "../components/Section.astro";
import { byFileOrder } from "../content/listOrder";
import { getSection } from "../content/requiredEntries";
import type { LabItem } from "../content/types";

const section = await getSection("labs");
const items: LabItem[] = (await getCollection("labs"))
  .map((entry) => entry.data)
  .sort(byFileOrder);
---

<Section
  id={section.id}
  title={section.title}
  description={section.description}
>
  <List>
    {items.map((item) => (
      <Row
        title={item.title}
        href={item.href}
        meta={item.stack}
        description={item.description}
      />
    ))}
  </List>
</Section>
