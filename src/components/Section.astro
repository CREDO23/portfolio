---
interface Props {
  id: string;
  title: string;
  description?: string;
  /** "large": a page-level title in the text colour, with more room below (Contact). */
  heading?: "default" | "large";
}

const { id, title, description, heading = "default" } = Astro.props;
const headingId = `${id}-heading`;
---

<section
  id={id}
  aria-labelledby={headingId}
  class:list={[{ large: heading === "large" }]}
>
  <h2 id={headingId}>{title}</h2>
  {description && <p>{description}</p>}
  <slot />
</section>

<style>
  section {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  h2 {
    margin: 0;
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
    color: var(--color-muted);
  }

  /* Smaller than the heading, which shares its colour, so the two read apart. */
  p {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .large {
    gap: var(--space-8);
  }

  .large h2 {
    font-size: var(--text-xl);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-title);
    color: var(--color-fg);
  }
</style>
